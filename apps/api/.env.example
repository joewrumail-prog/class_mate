# API Environment Variables
# Copy this to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# AI Schedule Parsing
# OpenAI is the default; Doubao takes priority only when its key is set
# (UNNC/China campus routing).
OPENAI_API_KEY=your-openai-key
OPENAI_VISION_MODEL=gpt-5.4-mini
DOUBAO_API_KEY=
DOUBAO_ENDPOINT_ID=doubao-seed-1-6-vision-250815

# Access Control
INVITE_CODE=your-invite-code
DAILY_MATCH_QUOTA=3
FRONTEND_ORIGINS=https://your-vercel-app.vercel.app

# Email (Resend) — required for seat-open alerts (skipped gracefully if unset)
RESEND_API_KEY=your-resend-key
# Sender for alerts. Default onboarding@resend.dev only delivers to the resend
# account owner's inbox — verify a domain in resend and set this for real users.
ALERT_FROM_EMAIL=ClassMate Alerts <alerts@yourdomain.com>

# Cron auth (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=generate-a-long-random-string
CAMPUS_TZ=America/New_York

# Server (local dev only)
PORT=3000
