{
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/scheduler/cron/daily-plan", "schedule": "0 10 * * *" },
    { "path": "/api/seatwatch/cron/poll", "schedule": "0 11 * * *" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
